{
  "name": "pokemon-go-retention-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run sites:snapshot:check && next dev",
    "build": "npm run sites:snapshot:check && vinext build",
    "start": "node scripts/start-sites.mjs",
    "dev:local": "npm run sites:snapshot && next dev",
    "build:local": "npm run sites:snapshot && next build",
    "start:local": "next start",
    "sites:snapshot": "tsx scripts/generate-sites-snapshot.ts",
    "sites:snapshot:check": "tsx scripts/check-sites-snapshot.ts",
    "sites:check": "vinext check",
    "sites:build": "npm run sites:snapshot && npm run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/remediation-integration.test.ts",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:import": "tsx scripts/import-data.ts",
    "data:remediate": "tsx scripts/remediate-001-030.ts",
    "data:backfill-iv": "tsx scripts/backfill-structured-iv.ts",
    "review:generate": "tsx scripts/generate-review.ts",
    "review:remediation": "tsx scripts/generate-remediation-report.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "better-sqlite3": "12.6.2",
    "dotenv": "17.2.3",
    "exceljs": "4.4.0",
    "lucide-react": "1.24.0",
    "next": "16.3.0-preview.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@tailwindcss/postcss": "4.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.28",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.19",
    "prettier": "3.9.5",
    "prisma": "7.9.0",
    "react-server-dom-webpack": "19.2.7",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "miniflare": {
      "sharp": "0.35.3"
    }
  }
}
