{
  "name": "pokemon-go-retention-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/remediation-integration.test.ts",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:import": "tsx scripts/import-data.ts",
    "data:remediate": "tsx scripts/remediate-001-030.ts",
    "review:generate": "tsx scripts/generate-review.ts",
    "review:remediation": "tsx scripts/generate-remediation-report.ts"
  },
  "dependencies": {
    "@next/swc-win32-x64-msvc": "16.2.10",
    "@prisma/adapter-better-sqlite3": "7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "12.6.2",
    "dotenv": "17.2.3",
    "exceljs": "4.4.0",
    "lucide-react": "1.24.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.6",
    "prettier": "3.9.5",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
