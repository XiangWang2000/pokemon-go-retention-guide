{
  "name": "pokemon-go-retention-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run snapshot:check && next dev",
    "build": "npm run build:pages",
    "build:pages": "npm run snapshot:check && node scripts/pages/build-pages.mjs",
    "pages:smoke": "node scripts/pages/smoke-pages-server.mjs",
    "pages:smoke:deployed": "node scripts/pages/smoke-deployed-pages.mjs",
    "pages:verify": "node --check scripts/pages/smoke-deployed-pages.mjs && node scripts/pages/verify-pages-artifact.mjs && npm run pages:smoke",
    "start": "node scripts/pages/serve-pages.mjs",
    "dev:local": "npm run snapshot:check && next dev",
    "build:local": "npm run snapshot:check && next build",
    "start:local": "next start",
    "release:snapshot": "node --import tsx scripts/release/prepare-release-snapshot.ts",
    "snapshot:check": "node --import tsx scripts/release/check-static-snapshot.ts --database-url file:./rebuild-ci.db",
    "release:verify": "node --import tsx scripts/release/verify-release.ts --database-url file:./rebuild-ci.db",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/remediation-integration.test.ts",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "node --import tsx scripts/data/assert-disposable-database.ts && prisma migrate reset --force",
    "data:validate": "node --import tsx scripts/data/validate-data.ts",
    "data:import": "node --import tsx scripts/data/import-data.ts",
    "data:import:batch": "node --import tsx scripts/data/import-batch.ts",
    "data:recompute": "node --import tsx scripts/data/recompute-retention.ts",
    "data:verify:gen4": "node --import tsx scripts/data/verify-import-gen4.ts",
    "data:verify:published-integrity": "node --import tsx scripts/data/verify-published-integrity.ts",
    "data:remediate": "node --import tsx scripts/data/remediate-001-030.ts",
    "data:materialize-iv": "node --import tsx scripts/data/materialize-structured-iv.ts",
    "review:generate": "node --import tsx scripts/review/generate-all-reviews.ts",
    "review:validate": "node --import tsx scripts/review/validate-review-consistency.ts",
    "review:remediation": "node --import tsx scripts/review/generate-remediation-report.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "12.6.2",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "@prisma/engines": true,
    "better-sqlite3": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
  }
}
